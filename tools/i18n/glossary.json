  "style": {
    "de": {
      "register": "Address the user informally with 'du' (as the game does). Swiss orthography as in the game: write 'ss', never 'ß'.",
      "button": "Commands (buttons, menu items, and labels or tooltips naming an action): infinitive form, as the game does ('Speichern', 'Diese Konfiguration löschen'). A status that something is in progress: 'Wird …'.",
      "evidence": {
        "register": [
          "Mit dem Linienmanager kannst du sämtliche Linien verwalten.",
          "Wenn du dich bereits gut auskennst, kannst du das Tutorial jederzeit beenden.",
          "Benutze den Güterfilter im Fahrzeugladen, um nach dem Gütertyp zu suchen, den du brauchst."
        ],
        "button": [
          "Speichern",
          "Löschen",
          "Umbenennen"
        ]
      }
    },
    "it": {
      "register": "Address the user informally with 'tu' (as the game does). 'mod' is feminine: 'la mod'.",
      "button": "Commands (buttons, menu items, and labels or tooltips naming an action): imperative 2nd person singular, as the game does ('Salva', 'Elimina questa configurazione').",
      "evidence": {
        "register": [
          "Il gestore linea ti consente di gestire tutte le linee.",
          "Se senti di aver acquisito la sicurezza necessaria, puoi concludere il tutorial in qualsiasi momento.",
          "Usa il filtro carico nel negozio veicoli per isolare il tipo di carico che ti interessa."
        ],
        "button": [
          "Salva",
          "Elimina",
          "Rinomina"
        ]
      }
    },
    "es": {
